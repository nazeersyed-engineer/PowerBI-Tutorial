table sales
	lineageTag: 77713675-41ab-40fa-bbef-53f8592ec63a

	measure 'Total Sales' = SUM(sales[Net_Sales_INR])
		formatString: ₹#,##0.00
		displayFolder: KPI Building
		lineageTag: f998011b-9a1f-421d-8a1a-059b83503333

	measure 'Total Quantity' = SUM(sales[Quantity])
		formatString: #,##0
		displayFolder: KPI Building
		lineageTag: 168a5cfc-046a-4202-9943-c0f8e85e65ab

	measure 'Total Profit' = SUM(sales[Gross_Profit_INR])
		formatString: ₹#,##0.00
		displayFolder: KPI Building
		lineageTag: ff11adab-a5b7-44ec-aa6e-e25ae3fd8a16

	measure 'Profit Margin %' = DIVIDE([Total Profit],[Total Sales])
		formatString: 0.00%
		displayFolder: KPI Building
		lineageTag: 4a505c8b-96eb-4298-acae-704765320486

	measure 'Average Order Value' = DIVIDE([Total Sales],DISTINCTCOUNT(sales[Order_ID]))
		formatString: ₹#,##0.00
		displayFolder: KPI Building
		lineageTag: 721e4358-c70f-412a-998e-1e370446dae4

	measure 'Sales YTD' = TOTALYTD([Total Sales],'Date'[Date])
		formatString: ₹#,##0.00
		displayFolder: KPI Building
		lineageTag: 5821d714-e802-48db-8110-29d47ad2ed23

	measure 'Previous Year Sales' = CALCULATE([Total Sales],SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: ₹#,##0.00
		displayFolder: KPI Building
		lineageTag: 4c847d81-8076-450b-97a2-760306b51ff1

	measure 'YoY Sales Growth' = [Total Sales]-[Previous Year Sales]
		formatString: ₹#,##0.00
		displayFolder: KPI Building
		lineageTag: 42b6ace5-c765-4362-8af5-c37cb2394f87

	measure 'YoY Sales Growth %' = DIVIDE([YoY Sales Growth],[Previous Year Sales])
		formatString: 0.00%
		displayFolder: KPI Building
		lineageTag: 5db9da67-a59f-4e9a-96e0-c9db983b72f2

	measure 'Running Total Sales' = CALCULATE([Total Sales],FILTER(ALLSELECTED('Date'[Date]),'Date'[Date]<=MAX('Date'[Date])))
		formatString: ₹#,##0.00
		displayFolder: KPI Building
		lineageTag: c28185d6-e991-4baa-9775-a7dbacd336a9

