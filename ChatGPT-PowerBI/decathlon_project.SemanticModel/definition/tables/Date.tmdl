	partition Date = calculated
		mode: import
		source = VAR MinDate = MINX(ALL(sales), sales[Purchase_Date]) VAR MaxDate = MAXX(ALL(sales), sales[Purchase_Date]) RETURN SELECTCOLUMNS(ADDCOLUMNS(CALENDAR(DATE(YEAR(MinDate),1,1),DATE(YEAR(MaxDate),12,31)),"Month Num",MONTH([Date]),"Month Name",FORMAT([Date],"MMMM"),"Year",YEAR([Date]),"Quarter Num",QUARTER([Date]),"Quarter","Q"&FORMAT(QUARTER([Date]),"0"),"Week Num",WEEKNUM([Date],2),"Day Num",DAY([Date]),"Day Name",FORMAT([Date],"dddd")),"Date",[Date],"Month Num",[Month Num],"Month Name",[Month Name],"Year",[Year],"Quarter Num",[Quarter Num],"Quarter",[Quarter],"Week Num",[Week Num],"Day Num",[Day Num],"Day Name",[Day Name])

